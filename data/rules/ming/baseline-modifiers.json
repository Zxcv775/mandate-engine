{
  "packId": "ming-baseline-rules",
  "description": "明朝基线规则（Phase 5 DSL v2）：直诏合法性代价与低稳定度执行阻力。",
  "dslVersion": 2,
  "rules": [
    {
      "id": "rule-direct-decree-legitimacy",
      "version": 1,
      "scope": "policy-legality",
      "description": "跳过朝议直诏立策：合法性受损（未经廷议，物议沸腾）",
      "priority": 100,
      "condition": { "op": "eq", "path": "policy.source", "value": "direct-decree" },
      "effects": [
        {
          "type": "adjust-country-metric",
          "metric": "legitimacy",
          "amount": -2,
          "reason": "未经廷议，中旨直下，清议非之"
        },
        {
          "type": "add-modifier",
          "modifier": {
            "target": { "kind": "context-policy" },
            "metric": "resistance",
            "operation": "add",
            "value": 10,
            "durationTicks": null,
            "stacking": "unique-by-source",
            "reason": "中旨直下，臣工观望，执行阻力上升"
          }
        }
      ],
      "sourceIds": ["ming-shi"]
    },
    {
      "id": "rule-legitimacy-collapse-block",
      "version": 1,
      "scope": "policy-legality",
      "description": "合法性崩坏（低于一成五）时直诏不行：中旨已无人奉行",
      "priority": 200,
      "condition": {
        "op": "and",
        "conditions": [
          { "op": "eq", "path": "policy.source", "value": "direct-decree" },
          { "op": "lt", "path": "country.legitimacy", "value": 15 }
        ]
      },
      "effects": [
        {
          "type": "set-policy-blocked",
          "reason": "威信扫地，中旨出而无人奉行，直诏立策不可行"
        }
      ],
      "sourceIds": ["ming-shi"]
    },
    {
      "id": "rule-low-stability-resistance",
      "version": 1,
      "scope": "policy-resolution",
      "description": "天下不靖（稳定度低于四成）：政令推行迟滞",
      "priority": 50,
      "condition": { "op": "lt", "path": "country.stability", "value": 40 },
      "effects": [
        {
          "type": "add-modifier",
          "modifier": {
            "target": { "kind": "context-policy" },
            "metric": "executionEfficiency",
            "operation": "mul",
            "value": 0.85,
            "durationTicks": 1,
            "stacking": "replace",
            "reason": "地方多故，政令难行"
          }
        }
      ],
      "sourceIds": ["ming-shi"]
    }
  ],
  "meta": {
    "sourceIds": ["ming-shi"],
    "confirmation": "gameplay-adjusted",
    "notes": "Phase 0 的欠饷士气示例（army.* 路径）因军队实体未实现而移除，Phase 9 军事系统恢复。数值为设计占位（gameplay-adjusted）。"
  }
}
