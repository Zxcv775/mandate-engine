# ---- LLM 供应商 ----
# mock = 离线 Mock（默认，测试/开发不触网）；openai-compatible = OpenAI 兼容端点（含本地模型）
LLM_PROVIDER=mock
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_MS=30000
LLM_MAX_RETRIES=2

# ---- 服务端 ----
SERVER_PORT=3000
LOG_LEVEL=info

# ---- 存档（Phase 2 启用）----
SAVE_DIR=./saves
