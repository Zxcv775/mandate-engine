# .env 是唯一运行时配置源；空值会按“未配置”处理。

# ---- 运行环境与服务端 ----
NODE_ENV=development
SERVER_HOST=127.0.0.1
SERVER_PORT=3000
LOG_LEVEL=info

# ---- LLM 供应商 ----
# mock = 离线 Mock（默认，测试/开发不触网）
# openai-compatible = OpenAI 兼容端点；本地端点可以不配置 API Key
LLM_PROVIDER=mock
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=mock-model
LLM_TIMEOUT_MS=30000
LLM_MAX_RETRIES=2

# ---- 当前剧本 ----
DEFAULT_SCENARIO_ID=chongzhen-early

# ---- Phase 2 本地 SQLite 存档 ----
SAVE_DATABASE_PATH=./saves/mandate-engine.sqlite
SAVE_CHECKPOINT_INTERVAL=50

# ---- Phase 3 人物系统 ----
# Debug API（人物上下文/记忆查询）；缺省时非生产环境开、生产环境关
DEBUG_API_ENABLED=
# 结构化输出最大修复次数（0-3）
CHARACTER_MAX_REPAIR_ATTEMPTS=1
# 单角色记忆条数上限
CHARACTER_MEMORY_MAX_PER_CHARACTER=500
